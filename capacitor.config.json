{
  "appId": "com.altomedia.indofarm",
  "appName": "INDOFARM",
  "webDir": "game",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "buildOptions": {
      "keystorePath": "indofarm-release.keystore",
      "keystoreAlias": "indofarm",
      "releaseType": "APK"
    },
    "minWebViewVersion": 60,
    "backgroundColor": "#0d1117",
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "AdMob": {
      "appId": {
        "android": "ca-app-pub-6881903056221433~6902713015"
      },
      "initializeForTesting": false
    }
  }
}
